# Copiar a .env solo para desarrollo; configurar estos mismos nombres en Railway.
# Usar una cuenta propia de la aplicación con los permisos necesarios.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=moskicheck_app
DB_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_LOCAL
DB_NAME=moskicheck_db
PORT=3000

# URL base del microservicio, sin /predecir.
MOSKICHECK_IA_URL=http://127.0.0.1:8000
